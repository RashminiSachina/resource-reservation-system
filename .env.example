# Database
DATABASE_URL="postgresql://user:password@localhost:5432/reservation_system"

# Session Secret (generate a cryptographically random 32+ character string)
SESSION_SECRET="your-session-secret-here"

# Admin Emails (comma-separated list of emails that should have admin privileges)
ADMIN_EMAILS="admin@example.com"

# Email Configuration (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@reserveit.local"
